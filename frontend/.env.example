# Backend API Base URL
# In local development: http://localhost:8000
# In production on Vercel: set to your deployed Render URL (e.g. https://geomeasure-backend.onrender.com)
VITE_API_URL=https://your-api.onrender.com

# Supabase Auth Configuration (Required for Developer Portal)
# Obtain from Supabase Dashboard -> Project Settings -> API
# Note: The anon key is safe for client-side inclusion. Never expose the service-role key to the frontend!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

