# Environment (development, test, production)
ENVIRONMENT=production

# Supabase PostgreSQL connection string (direct or pooled)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# In-memory storage permission (set to false in production)
ALLOW_IN_MEMORY_DB=false

# CORS allowed origins (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Upload and decompression limits
MAX_UPLOAD_SIZE_MB=50
MAX_DECOMPRESSED_SIZE_MB=200

# Supabase Auth Configuration
# Used to verify user ownership tokens for API key management endpoints (/api/keys/)
# If using symmetric signing (HS256):
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# If using modern asymmetric signing (RS256/ES256 via JWKS):
SUPABASE_URL=https://your-project-ref.supabase.co

# Phase 4: AI Copilot with Low-Latency Hybrid Inference
# Local Ollama Configuration (Default local dev model: qwen3.5:2b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# Hosted Provider Configuration (e.g. Groq with low latency)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Routing Policy: local_first, hosted_first, local_only, hosted_only
AI_PROVIDER_MODE=local_first
# Privacy Mode: standard, local_only (local_only strictly prevents cloud transmission)
AI_PRIVACY_MODE=standard
AI_REQUEST_TIMEOUT_SECONDS=12.0
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_RPM=15
AI_MONTHLY_QUOTA=500


